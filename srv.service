[Unit]
Description=Austrian LIDAR Analysis API
After=network.target

[Service]
User=exedev
WorkingDirectory=/home/exedev/srtm-lidar
ExecStart=/home/exedev/.local/bin/gunicorn -w 2 -b 0.0.0.0:8000 --timeout 120 app:app
Restart=on-failure
RestartSec=5
Environment=GDAL_HTTP_MERGE_CONSECUTIVE_RANGES=YES
Environment=GDAL_HTTP_MULTIPLEX=YES
Environment=VSI_CACHE=TRUE
Environment=VSI_CACHE_SIZE=134217728

[Install]
WantedBy=multi-user.target
