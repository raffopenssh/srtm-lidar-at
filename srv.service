[Unit]
Description=Austrian LIDAR Analysis API
After=network.target

[Service]
User=exedev
WorkingDirectory=/home/exedev/srtm-lidar
ExecStart=/home/exedev/.local/bin/gunicorn -w 2 --threads 4 -b 0.0.0.0:8000 --timeout 600 app:app
Restart=on-failure
RestartSec=5
Environment=GDAL_HTTP_MERGE_CONSECUTIVE_RANGES=YES
Environment=GDAL_HTTP_MULTIPLEX=YES
Environment=VSI_CACHE=TRUE
Environment=VSI_CACHE_SIZE=134217728
# Prevent gunicorn from OOM-killing the RF training process
# Raised from 3G/2.5G: all-options-on analysis with large areas needs ~3.5GB
MemoryMax=5G
MemoryHigh=4G
OOMScoreAdjust=500
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
